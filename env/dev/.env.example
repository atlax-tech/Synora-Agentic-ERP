# 复制为 env/dev/.env（gitignored），为每项填入本机专用的随机开发值。
# 真实 .env / site 密码 / DB 凭据不得进入日志或证据文档。
COMPOSE_PROJECT_NAME=synora_phase1_dev

# 一次性 disposable site 开发凭据；故意留空，脚本会拒绝空值。
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# bench site（由脚本生成，非本文件）
# FRAPPE_SITE=dev.localhost
ADMIN_PASSWORD=

# Phase 1 命名 P2P 测试用户共用的本机随机密码；不进入 argv、日志或证据。
SYNORA_P2P_USER_PWD=

# ===== Phase 8 named model roles (BYOK/local; Coach priority is fixed) =====
# 当前 Coach 主链固定为 qwen3:8b → glm-5.3-flash → grok-4.5 → qwen3.8:27b。
# 四个角色的键必须成组填写；模型名由代码校验，缺失/混用旧选择键会 fail closed。
# API Key 只放在 gitignored 的 env/dev/.env；此示例不填写任何 secret。
# 主模型（本地 Ollama）
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=
# OLLAMA_MODEL=qwen3:8b
# 辅助模型（GLM）
# ASSIST_BASE_URL=https://api.example.com/v1
# ASSIST_API_KEY=
# ASSIST_MODEL=glm-5.3-flash
# 收费备用（Grok）
# BACKUP_BASE_URL=https://api.example.com/v1
# BACKUP_API_KEY=
# BACKUP_MODEL=grok-4.5
# 本地最后备用（慢，不设置 read timeout）
# BACKUP_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# BACKUP_OLLAMA_API_KEY=
# BACKUP_OLLAMA_MODEL=qwen3.8:27b

# 可选的远端显式代理/推理策略仍只影响 named role 的远端请求；默认不读取系统代理。
# SYNORA_PROVIDER_PROXY=http://127.0.0.1:7899
# SYNORA_PROVIDER_REASONING_EFFORT=low
# SYNORA_PROVIDER_THINKING=disabled

# ===== P3.4 legacy model Provider (仅旧部署兼容，不得与上面的 named roles 混用) =====
# 你在 .env 中自行填写（本文件留空）；真实值只存在于 gitignored 的 env/dev/.env。
# 代码通过 provider_from_environment() 读取，API Key 以 SecretStr 脱敏保存，
# 不会出现在 repr/str/异常/日志/Git 中；未配置 Base URL 时 Provider 构造 fail closed。
# SYNORA_PROVIDER_BASE_URL 通常带 /v1，如 https://api.example.com/v1（纯域名会被拒绝）
# SYNORA_PROVIDER_BASE_URL=
# SYNORA_PROVIDER_API_KEY=
# SYNORA_PROVIDER_MODEL=
# GLM-4.7 等智谱模型可关闭思考输出，避免响应只剩 reasoning_content。(为保证输出质量默认开启)
# SYNORA_PROVIDER_THINKING=disabled
# Grok reasoning model 可显式设为 low, 降低简单解释的延迟与 token 消耗。
# SYNORA_PROVIDER_REASONING_EFFORT=low

# ===== 可选 Provider 故障转移 =====
# 主 Provider（默认 GLM）仅在限流、上游 5xx、超时或网络不可达时使用备用。
# 只填写 FALLBACK_API_KEY 即沿用主 Provider 的 Base URL、模型、代理和思考设置；
# 备用 API 不同于主 API 时，再填写下面的 BASE_URL/MODEL/PROXY 等覆盖项。
# SYNORA_PROVIDER_FALLBACK_API_KEY=
# SYNORA_PROVIDER_FALLBACK_BASE_URL=
# SYNORA_PROVIDER_FALLBACK_MODEL=
# SYNORA_PROVIDER_FALLBACK_THINKING=disabled
# SYNORA_PROVIDER_FALLBACK_PROXY=http://127.0.0.1:7899
# SYNORA_PROVIDER_FALLBACK_REASONING_EFFORT=low

# Docker Bench 访问宿主机 Agent Runtime 时的显式开发配置。
# host-gateway 只在本地开发网络启用, 必须同时设置内部令牌; 令牌不要提交。
# SYNORA_RUNTIME_URL=http://host.docker.internal:8001
# SYNORA_RUNTIME_ALLOW_HOST_GATEWAY=1
# SYNORA_RUNTIME_TOKEN=
