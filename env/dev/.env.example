# 复制为 env/dev/.env（gitignored），为每项填入本机专用的随机开发值。
# 真实 .env / site 密码 / DB 凭据不得进入日志或证据文档。
COMPOSE_PROJECT_NAME=synora_phase1_dev

# 一次性 disposable site 开发凭据；故意留空，脚本会拒绝空值。
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# bench site（由脚本生成，非本文件）
# FRAPPE_SITE=dev.localhost
ADMIN_PASSWORD=

# Phase 1 命名 P2P 测试用户共用的本机随机密码；不进入 argv、日志或证据。
SYNORA_P2P_USER_PWD=

# ===== P3.4 模型 Provider（BYOK，可选）=====
# 你在 .env 中自行填写（本文件留空）；真实值只存在于 gitignored 的 env/dev/.env。
# 代码通过 provider_from_environment() 读取，API Key 以 SecretStr 脱敏保存，
# 不会出现在 repr/str/异常/日志/Git 中；未配置 Base URL 时 Provider 构造 fail closed。
# SYNORA_PROVIDER_BASE_URL=https://api.example.com
# SYNORA_PROVIDER_API_KEY=
# SYNORA_PROVIDER_MODEL=
