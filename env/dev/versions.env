# Synora Phase 1 开发环境候选版本（Inc-1 / P1.1）
# 由 scripts/dev/* 与 docker-compose 显式消费；原始值经 resolve-refs 解析为 FDP_REV_* 候选 SHA。
# FDP_REV_* 先由脚本回填并逐项断言，P1.5 通过独立对抗审查后才视为正式基线。
FDP_VER_NODE=24
FDP_VER_BENCH=5.31.0
FDP_VER_MARIADB=11.4
FDP_VER_REDIS=7
FDP_BASE_IMAGE=python:3.14-bookworm

# 克隆传输参考分支（raw SHA 不传给 --frappe-branch）
FDP_REF_FRAPPE=version-16
FDP_REF_ERP_NEXT=version-16
# 候选 SHA：由 resolve-refs.sh 用 git ls-remote 回填；构建后断言两个 HEAD 与之相等
FDP_REV_FRAPPE=6a329d068416768ec47ccd3326b9cc95a8d7bf99
FDP_REV_ERP_NEXT=11e0ba0a1c45f217e2e73e885f699102d06da325

# 仅作用于本项目明确声明的容器/卷
COMPOSE_PROJECT_NAME=synora_phase1_dev
